{
  "$schema": "https://raw.githubusercontent.com/Kitware/CMake/master/Help/manual/presets/schema.json",
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Development (Debug, tests)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "@PROJECT_NAME@_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (Release, tests, warnings as errors)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "@PROJECT_NAME@_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (Debug, gcov instrumentation)",
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "--coverage",
        "@PROJECT_NAME@_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "docs",
      "displayName": "Doxygen documentation",
      "inherits": "base",
      "cacheVariables": {
        "@PROJECT_NAME@_BUILD_DOCS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug"
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "configuration": "Release"
    },
    {
      "name": "ci-verify-headers",
      "configurePreset": "ci",
      "configuration": "Release",
      "targets": [
        "all_verify_interface_header_sets"
      ]
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "configuration": "Debug"
    },
    {
      "name": "docs",
      "configurePreset": "docs",
      "targets": [
        "docs"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "ignore"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "configurePreset": "dev",
      "configuration": "Debug"
    },
    {
      "name": "ci",
      "inherits": "base",
      "configurePreset": "ci",
      "configuration": "Release"
    },
    {
      "name": "coverage",
      "inherits": "base",
      "configurePreset": "coverage",
      "configuration": "Debug"
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "ci",
      "steps": [
        { "type": "configure", "name": "ci" },
        { "type": "build", "name": "ci" },
        { "type": "build", "name": "ci-verify-headers" },
        { "type": "test", "name": "ci" }
      ]
    },
    {
      "name": "coverage",
      "steps": [
        { "type": "configure", "name": "coverage" },
        { "type": "build", "name": "coverage" },
        { "type": "test", "name": "coverage" }
      ]
    },
    {
      "name": "docs",
      "steps": [
        { "type": "configure", "name": "docs" },
        { "type": "build", "name": "docs" }
      ]
    }
  ]
}
