# @PROJECT_NAME@ Library

cmake_minimum_required(VERSION 4.5)
project(@PROJECT_NAME@
    VERSION 0.0.1
    DESCRIPTION "@PROJECT_DESCRIPTION@"
    LANGUAGES CXX
)

include(CMakeDependentOption)
include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

#########################################################################
# Options                                                               #
#########################################################################

option(BUILD_SHARED_LIBS "Build libraries as shared libraries" OFF)

cmake_dependent_option(${PROJECT_NAME}_BUILD_TESTS
    "Build ${PROJECT_NAME} tests" OFF "PROJECT_IS_TOP_LEVEL" OFF)
cmake_dependent_option(${PROJECT_NAME}_BUILD_DOCS
    "Build ${PROJECT_NAME} Doxygen documentation" OFF "PROJECT_IS_TOP_LEVEL" OFF)
cmake_dependent_option(${PROJECT_NAME}_INSTALL
    "Generate ${PROJECT_NAME} install rules" ON "PROJECT_IS_TOP_LEVEL" OFF)

if(PROJECT_IS_TOP_LEVEL)
    if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
        set(CMAKE_BUILD_TYPE "Release" CACHE STRING "Choose the type of build." FORCE)
        set_property(CACHE CMAKE_BUILD_TYPE PROPERTY STRINGS "Debug" "Release" "MinSizeRel" "RelWithDebInfo")
    endif()

    # Keep executables and DLLs together so tests can load shared builds on Windows
    set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${PROJECT_BINARY_DIR}/bin)
endif()

#########################################################################
# Dependencies                                                          #
#########################################################################

include(FetchContent)

if(${PROJECT_NAME}_BUILD_TESTS)
    set(gtest_force_shared_crt ON CACHE BOOL "" FORCE)
    set(INSTALL_GTEST OFF CACHE BOOL "" FORCE)
    FetchContent_Declare(
        GoogleTest
        GIT_REPOSITORY https://github.com/google/googletest.git
        GIT_TAG        v1.17.0
        GIT_SHALLOW    TRUE
        EXCLUDE_FROM_ALL
        SYSTEM
        FIND_PACKAGE_ARGS NAMES GTest
    )
    # Third-party code is not held to this project's warnings-as-errors
    block()
        set(CMAKE_COMPILE_WARNING_AS_ERROR OFF)
        FetchContent_MakeAvailable(GoogleTest)
    endblock()
endif()

# FetchContent_Declare(
#     nlohmann_json
#     GIT_REPOSITORY https://github.com/nlohmann/json.git
#     GIT_TAG        v3.12.0
#     GIT_SHALLOW    TRUE
#     EXCLUDE_FROM_ALL
#     SYSTEM
#     FIND_PACKAGE_ARGS
# )
# FetchContent_MakeAvailable(nlohmann_json)

#########################################################################
# Build                                                                 #
#########################################################################

add_library(${PROJECT_NAME})
add_library(${PROJECT_NAME}::${PROJECT_NAME} ALIAS ${PROJECT_NAME})

target_sources(${PROJECT_NAME}
    PRIVATE
        @PROJECT_NAME@.cpp
    PUBLIC
        FILE_SET HEADERS
        BASE_DIRS include
        FILES
            include/@PROJECT_NAME@/@PROJECT_NAME@.h
)

target_include_directories(${PROJECT_NAME}
    PRIVATE
        ${CMAKE_CURRENT_SOURCE_DIR}
        ${CMAKE_CURRENT_SOURCE_DIR}/include/${PROJECT_NAME}
)

target_link_libraries(${PROJECT_NAME}
    PRIVATE
#        nlohmann_json::nlohmann_json
)

target_compile_features(${PROJECT_NAME} PUBLIC cxx_std_17)

target_compile_options(${PROJECT_NAME}
    PRIVATE
        $<$<CXX_COMPILER_ID:MSVC>:/W4 /permissive->
        $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-Wall -Wextra -Wpedantic>
)

target_compile_definitions(${PROJECT_NAME}
    PRIVATE
        $<$<PLATFORM_ID:Windows>:NOMINMAX WIN32_LEAN_AND_MEAN UNICODE _UNICODE>
)

set_target_properties(${PROJECT_NAME} PROPERTIES
    CXX_EXTENSIONS OFF
    VERSION ${PROJECT_VERSION}
    SOVERSION ${PROJECT_VERSION_MAJOR}
    DEBUG_POSTFIX d
    VERIFY_INTERFACE_HEADER_SETS ${PROJECT_IS_TOP_LEVEL}
)

#########################################################################
# Documentation                                                         #
#########################################################################

if(${PROJECT_NAME}_BUILD_DOCS)
    find_package(Doxygen REQUIRED OPTIONAL_COMPONENTS dot)

    set(DOXYGEN_JAVADOC_AUTOBRIEF YES)
    set(DOXYGEN_QT_AUTOBRIEF YES)
    set(DOXYGEN_FULL_PATH_NAMES NO)
    set(DOXYGEN_STRIP_FROM_INC_PATH ${CMAKE_CURRENT_SOURCE_DIR}/include)
    set(DOXYGEN_HIDE_FRIEND_COMPOUNDS YES)
    set(DOXYGEN_HIDE_IN_BODY_DOCS YES)
    set(DOXYGEN_SORT_BY_SCOPE_NAME YES)
    set(DOXYGEN_SHOW_USED_FILES NO)
    set(DOXYGEN_TEMPLATE_RELATIONS YES)
    set(DOXYGEN_HTML_COLORSTYLE AUTO_LIGHT)
    set(DOXYGEN_USE_MDFILE_AS_MAINPAGE ${CMAKE_CURRENT_SOURCE_DIR}/README.md)

    doxygen_add_docs(docs
        include
        @PROJECT_NAME@.cpp
        README.md
        ALL
        USES_TERMINAL
        COMMENT "Generating ${PROJECT_NAME} API documentation with Doxygen"
    )
endif()

#########################################################################
# Testing                                                               #
#########################################################################

if(${PROJECT_NAME}_BUILD_TESTS)
    enable_testing()
    add_subdirectory(test)
endif()

#########################################################################
# Installation                                                          #
#########################################################################

if(${PROJECT_NAME}_INSTALL)
    set(${PROJECT_NAME}_INSTALL_CMAKEDIR ${CMAKE_INSTALL_LIBDIR}/cmake/${PROJECT_NAME})

    install(TARGETS ${PROJECT_NAME}
        EXPORT ${PROJECT_NAME}Targets
        FILE_SET HEADERS
    )

    install(EXPORT ${PROJECT_NAME}Targets
        NAMESPACE ${PROJECT_NAME}::
        DESTINATION ${${PROJECT_NAME}_INSTALL_CMAKEDIR}
    )

    configure_package_config_file(
        cmake/${PROJECT_NAME}Config.cmake.in
        ${PROJECT_BINARY_DIR}/${PROJECT_NAME}Config.cmake
        INSTALL_DESTINATION ${${PROJECT_NAME}_INSTALL_CMAKEDIR}
    )

    # SemanticVersion treats 0.y releases as mutually incompatible
    write_basic_package_version_file(
        ${PROJECT_BINARY_DIR}/${PROJECT_NAME}ConfigVersion.cmake
        COMPATIBILITY SemanticVersion
    )

    install(FILES
        ${PROJECT_BINARY_DIR}/${PROJECT_NAME}Config.cmake
        ${PROJECT_BINARY_DIR}/${PROJECT_NAME}ConfigVersion.cmake
        DESTINATION ${${PROJECT_NAME}_INSTALL_CMAKEDIR}
    )

    # Common Package Specification description
    install(PACKAGE_INFO ${PROJECT_NAME}
        EXPORT ${PROJECT_NAME}Targets
        LICENSE "MIT"
    )

    # SPDX software bill of materials
    install(SBOM ${PROJECT_NAME}
        EXPORTS ${PROJECT_NAME}Targets
        DEFAULT_LICENSE "MIT"
    )

    if(${PROJECT_NAME}_BUILD_DOCS)
        install(DIRECTORY ${PROJECT_BINARY_DIR}/html/
            DESTINATION ${CMAKE_INSTALL_DOCDIR}
            OPTIONAL
        )
    endif()
endif()
