#########################################################################
# Libraries                                                             #
#########################################################################


#########################################################################
# Executables                                                           #
#########################################################################

add_executable(@EXECUTABLE_NAME@)

target_sources(@EXECUTABLE_NAME@
    PRIVATE
        main.cpp
)

target_include_directories(@EXECUTABLE_NAME@
    PRIVATE
        ${CMAKE_CURRENT_SOURCE_DIR}
)

target_link_libraries(@EXECUTABLE_NAME@
    PRIVATE
#        CLI11::CLI11
#        nlohmann_json::nlohmann_json
#        Misc::Misc
#        $<$<TARGET_EXISTS:Wx::Wx>:Wx::Wx>
)

target_compile_features(@EXECUTABLE_NAME@ PRIVATE cxx_std_17)

target_compile_options(@EXECUTABLE_NAME@
    PRIVATE
        $<$<CXX_COMPILER_ID:MSVC>:/W4 /permissive->
        $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-Wall -Wextra -Wpedantic>
)

target_compile_definitions(@EXECUTABLE_NAME@
    PRIVATE
        $<$<PLATFORM_ID:Windows>:NOMINMAX WIN32_LEAN_AND_MEAN UNICODE _UNICODE>
)

set_target_properties(@EXECUTABLE_NAME@ PROPERTIES CXX_EXTENSIONS OFF)

#########################################################################
# Testing                                                               #
#########################################################################

if(${PROJECT_NAME}_BUILD_TESTS)
    enable_testing()
    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/test/CMakeLists.txt")
        add_subdirectory(test)
    else()
        message(STATUS "${PROJECT_NAME}: no test directory found")
    endif()
endif()
