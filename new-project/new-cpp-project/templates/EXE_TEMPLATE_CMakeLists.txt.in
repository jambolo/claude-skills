# @PROJECT_NAME@ Project

cmake_minimum_required(VERSION 3.28...4.5)
project(@PROJECT_NAME@
    VERSION 0.0.1
    DESCRIPTION "@PROJECT_DESCRIPTION@"
    LANGUAGES CXX
)

include(CMakeDependentOption)

#########################################################################
# Options                                                               #
#########################################################################

option(BUILD_SHARED_LIBS "Build libraries as shared libraries" OFF)

cmake_dependent_option(${PROJECT_NAME}_BUILD_TESTS
    "Build ${PROJECT_NAME} tests" OFF "PROJECT_IS_TOP_LEVEL" OFF)

if(PROJECT_IS_TOP_LEVEL)
    if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
        set(CMAKE_BUILD_TYPE "Release" CACHE STRING "Choose the type of build." FORCE)
        set_property(CACHE CMAKE_BUILD_TYPE PROPERTY STRINGS "Debug" "Release" "MinSizeRel" "RelWithDebInfo")
    endif()

    # Keep executables and DLLs together so they run from the build tree on Windows
    set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${PROJECT_BINARY_DIR}/bin)
endif()

#########################################################################
# Dependencies                                                          #
#########################################################################

include(FetchContent)

if(${PROJECT_NAME}_BUILD_TESTS)
    set(gtest_force_shared_crt ON CACHE BOOL "" FORCE)
    set(INSTALL_GTEST OFF CACHE BOOL "" FORCE)
    FetchContent_Declare(
        GoogleTest
        GIT_REPOSITORY https://github.com/google/googletest.git
        GIT_TAG        v1.17.0
        GIT_SHALLOW    TRUE
        EXCLUDE_FROM_ALL
        SYSTEM
        FIND_PACKAGE_ARGS NAMES GTest
    )
    # Third-party code is not held to this project's warnings-as-errors
    block()
        set(CMAKE_COMPILE_WARNING_AS_ERROR OFF)
        FetchContent_MakeAvailable(GoogleTest)
    endblock()
endif()

